# ─── Required ───────────────────────────────────────────────────────────────
# PostgreSQL (Neon, Supabase, local Postgres, etc.)
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require

# Session signing — minimum 32 characters (no quotes needed)
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Public app URL (used in emails and referral links)
APP_URL=http://localhost:3000

# ─── AI extraction (required for scans) ─────────────────────────────────────
AI_API_KEY=your-gemini-or-compatible-api-key

# ─── Email (optional locally; required for verify-email flow) ───────────────
# Resend API key — transactional emails (auth, billing, wallet, password)
RESEND_API_KEY=
# Verified sender on your Resend domain (defaults to onboarding@resend.dev locally)
EMAIL_FROM=GetPGN <noreply@yourdomain.com>

# ─── Razorpay (optional locally unless testing checkout) ───────────────────
RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=
# RAZORPAY_ALLOW_TEST_KEYS=true  # allow rzp_test_ keys when NODE_ENV=production (npm run start)
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_MONTHLY_PLAN_ID=plan_...
RAZORPAY_YEARLY_PLAN_ID=plan_...
RAZORPAY_ENTERPRISE_PLAN_ID=plan_...

# Create Enterprise plan only (keeps existing monthly/yearly IDs):
# node --env-file=.env scripts/razorpay-setup-plans.mjs --enterprise-only

# ─── Plan catalog (server — optional overrides, defaults shown) ──────────────
PLAN_MONTHLY_PRICE_INR=100
PLAN_YEARLY_PRICE_INR=1000
PLAN_ENTERPRISE_PRICE_INR=4000
PLAN_MONTHLY_SCAN_LIMIT=100
PLAN_YEARLY_SCAN_LIMIT=1000
PLAN_ENTERPRISE_SCAN_LIMIT=1000

# ─── Plan display (client — keep in sync with server values) ────────────────
NEXT_PUBLIC_PLAN_MONTHLY_PRICE_INR=100
NEXT_PUBLIC_PLAN_YEARLY_PRICE_INR=1000
NEXT_PUBLIC_PLAN_ENTERPRISE_PRICE_INR=4000
NEXT_PUBLIC_PLAN_MONTHLY_SCAN_LIMIT=100
NEXT_PUBLIC_PLAN_YEARLY_SCAN_LIMIT=1000
NEXT_PUBLIC_PLAN_ENTERPRISE_SCAN_LIMIT=1000

# ─── Homepage content (optional) ────────────────────────────────────────────
# NEXT_PUBLIC_HOME_VIDEO_URL=
# NEXT_PUBLIC_SHOWCASE_SCORESHEET_URL=/showcase/scoresheet.jpg
# NEXT_PUBLIC_SHOWCASE_PGN_URL=/showcase/pgn-output.png

# ─── Dev helpers (non-production only) ───────────────────────────────────────
# IS_DEV=true   # show [Simulate Pro] and dev API routes (default when unset)
# IS_DEV=false  # hide dev UI even under npm run dev
